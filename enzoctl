def cmd_mode(args):
    import re
    C = _paths()
    target = (args.target or "").lower()
    if target not in ("live", "paper"):
        return _set(args, {"error": "target must be live or paper"},
                    [red("usage: ./enzoctl mode live|paper")], 2)

    with open(C.CONFIG_PATH, "r", encoding="utf-8") as f:
        text = f.read()
    new_val = "false" if target == "live" else "true"
    pat = re.compile(r"^(\s*paper_mode\s*:\s*)(true|false)(.*)$", re.MULTILINE)
    if not pat.search(text):
        return _set(args, {"error": "paper_mode key not found"},
                    [red("could not find a top-level 'paper_mode:' key in the YAML")], 1)
    updated, n = pat.subn(lambda m: f"{m.group(1)}{new_val}{m.group(3)}", text, count=1)

    backup = C.CONFIG_PATH + ".bak"
    with open(backup, "w", encoding="utf-8") as f:
        f.write(text)
    with open(C.CONFIG_PATH, "w", encoding="utf-8") as f:
        f.write(updated)

    # Invalidate the mtime cache so the running process picks it up.
    try:
        from enzo.core import config as _C
        _C._CFG_CACHE.update({"mtime": None, "size": None, "cfg": None})
    except Exception:
        pass

    lines = [green(f"✔  paper_mode = {new_val} ({target.upper()})"),
             dim(f"   backup: {backup}")]
    if target == "live":
        lines += ["", red("   ⚠  LIVE MODE — the bot will trade REAL money."),
                  yellow("   Run ./enzoctl doctor and confirm every check passes first.")]
    pid, alive, _ = _pid()
    if alive:
        lines.append(dim("   The running engine re-reads the config on its next cycle."))
    return _set(args, {"paper_mode": new_val == "true", "mode": target}, lines, 0)


