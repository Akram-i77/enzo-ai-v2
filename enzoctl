        return _set(args, {section: cfg[section]}, [bold(f"{section}:"), body], 0)
    if args.json:
        return _set(args, cfg, [], 0)
    lines = [bold("Effective config (YAML deep-merged over built-in defaults)"),
             dim(f"source: {_paths().CONFIG_PATH}"), ""]
    for k in sorted(cfg):
        v = cfg[k]
        if isinstance(v, dict):
            lines.append(f"  {bold(k)}")
            for kk, vv in v.items():
                lines.append(f"      {kk:<34s} {str(vv)[:70]}")
        else:
            lines.append(f"  {bold(k):<36s} {str(v)[:70]}")
    return _set(args, cfg, lines, 0)


