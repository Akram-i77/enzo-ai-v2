    closed = st.get("closed_positions") or []
    lines = [bold("Open positions"), ""]
    if not opens:
        lines.append(dim("  none"))
    for mint, p in opens.items():
        entry = float(p.get("entry_price") or 0)
        cur_mc = float(p.get("current_market_cap") or 0)
        upnl = float(p.get("unrealized_pnl") or 0)
        lines.append(f"  {bold(str(p.get('symbol','?'))):<10s} ${float(p.get('size_usd') or 0):>9,.2f}"
                     f"  uPnL {green(f'${upnl:+,.2f}') if upnl >= 0 else red(f'${upnl:+,.2f}')}"
                     f"  mcap ${cur_mc:,.0f}"
                     f"  opened {_human_age(_age_of(p.get('opened_at')))}")
        lines.append(dim(f"            mint {mint[:20]}…  tx {str(p.get('tx_hash') or '—')[:20]}"))
    lines += ["", bold(f"Closed trades: {len(closed)}"), ""]
    for t in closed[: int(args.limit or 10)]:
