def cmd_scan(args):
    from enzo.core import engine
    from enzo.ui import botctl
    if botctl.is_paused():
        return _set(args, {"scanned": False, "reason": "paused"},
                    [yellow("ENZO is paused — ./enzoctl resume first.")], 1)

    pid, alive, _ = _pid()
    if alive and not args.force:
        return _set(args, {"scanned": False, "reason": "engine_running"},
                    [yellow("The engine is already running and scanning on its own interval."),
                     dim("   Use --force to run an extra cycle now (it will take the scan lock),"),
                     dim("   or ./enzoctl logs -f to watch the running cycle.")], 0)

    t0 = time.time()
    mints = [args.mint] if args.mint else None
    results = engine.scan_once(mints)
    dt = time.time() - t0

    lines = [bold(f"Scan complete in {dt:.1f}s — {len(results)} decision(s)"), ""]
    buys = 0
    for r in results:
        dec = r.get("decision")
        sym = r.get("token_symbol", "?")
        conf = r.get("confidence_score", 0)
        colour = green if dec == "BUY" else (yellow if dec in ("WAIT", "NOT_TRADABLE") else dim)
        lines.append(f"  {colour(f'{dec:<14s}')} {sym:<12s} conf={conf}")
        if dec == "BUY":
            buys += 1
        fr = r.get("failure_reason") or r.get("reason")
        if fr:
            lines.append(dim(f"                 {str(fr)[:110]}"))
    if not results:
        lines.append(yellow("  no candidates were discovered this cycle."))
        try:
            faults = engine.discovery_faults()
            for k, v in faults.items():
                lines.append(red(f"  discovery fault {k}: {v[:120]}"))
        except Exception:
            pass
        lines.append(dim("  ./enzoctl doctor   shows the data-source status."))

    return _set(args, {"scanned": True, "decisions": results, "seconds": round(dt, 2),
                       "buys": buys}, lines, 0)


