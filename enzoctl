def _gmgn_cli_dialect(gbin):
    """Which address flag the installed gmgn-cli accepts — no API call needed.

    v1.6 renamed `--token` to `--address` on every data command. The provider
    negotiates both at runtime, but `doctor` should be able to SAY which build is
    installed instead of leaving the operator to guess from an empty market.
    """
    out = {"version": None, "flag": None, "error": None}
    if not gbin:
        out["error"] = "gmgn-cli not found"
        return out
    try:
        v = subprocess.run([str(gbin), "--version"], capture_output=True, text=True, timeout=20)
        txt = ((v.stdout or "") + (v.stderr or "")).strip()
        out["version"] = (txt.splitlines()[0][:40] if txt else None)
    except Exception as e:                                        # noqa: BLE001
        out["error"] = f"--version: {type(e).__name__}"
    try:
        h = subprocess.run([str(gbin), "token", "info", "--help"],
                           capture_output=True, text=True, timeout=25)
        txt = (h.stdout or "") + (h.stderr or "")
        if "--address" in txt:
            out["flag"] = "--address"
        elif "--token" in txt:
            out["flag"] = "--token"
        else:
            out["error"] = out["error"] or "help lists neither --address nor --token"
    except Exception as e:                                        # noqa: BLE001
        out["error"] = f"{type(e).__name__}: {e}"[:120]
    return out


def _mark(state):
    """✔ / ✘ / ? for a gate result: pass, veto, unknown."""
    if state is True:
        return green("✔ pass ")
    if state is False:
        return red("✘ VETO ")
    return yellow("? unknown")


def _money(v):
    return f"${float(v):,.0f}" if v is not None else yellow("unknown")


def cmd_probe(args):
    """Print exactly what the gates see for one mint, from the live provider.

    Diagnosis without guessing: every number the Pump-V1 / phase / sniper / fees
    / holder-concentration gates read is printed next to the threshold it is
    compared against, and the REAL pipeline verdict (analyze.run_pipeline) last,
    so `probe` and the trading loop can never disagree.
    """
    from enzo.providers import gmgn as G
    from enzo.analyzers import analyze as A
    cfg = _cfg()
    mint = str(args.mint or "").strip()
    deep = not args.no_deep
    tu = cfg.get("token_universe") or {}
    pg = cfg.get("phase_gates") or {}
    sf = cfg.get("sniper_flood") or {}
    pre, mig = (pg.get("pre_migration") or {}), (pg.get("migrated") or {})
    mhp = (cfg.get("market_analysis") or {}).get("max_holder_percentage")

    lines = [bold(f"ENZO probe — {mint}"), ""]

    # ── provider readiness ──────────────────────────────────────────────────
    gbin = G.resolve_gmgn_bin(cfg)
    pst = G.provider_status()
    dia = _gmgn_cli_dialect(gbin)
    lines += [bold("Provider"),
              f"  gmgn-cli        : {gbin or red('NOT FOUND')}"
              f"{dim('  (' + str(dia.get('version')) + ')') if dia.get('version') else ''}",
              f"  address flag    : {dia.get('flag') or yellow('unknown')}",
              f"  GMGN_API_KEY    : "
              + (green("present") if pst.get("api_key_present")
                 else red("MISSING — every call fails")),
              f"  pacing          : {((cfg.get('data_sources') or {}).get('gmgn') or {}).get('requests_per_sec')}"
              f" req/s · gap {((cfg.get('data_sources') or {}).get('gmgn') or {}).get('request_gap_ms')}ms",
              ""]

    # ── live payload ────────────────────────────────────────────────────────
    info, md, lp = {}, {}, {}
    try:
        info = G.token_info(mint) or {}
    except Exception as e:                                    # noqa: BLE001
        lines.append(red(f"  token info failed: {e}"))
    try:
        md = G.get_market_data(mint) or {}
    except Exception as e:                                    # noqa: BLE001
        lines.append(red(f"  market data failed: {e}"))
    lp = G.launchpad_profile(dict(info, **(md.get("launchpad") or {}))) or {}
    sig = md.get("signals") or {}

    created = None
    for k in ("creation_timestamp", "open_timestamp", "created_timestamp"):
        v = info.get(k) or (info.get("dev") or {}).get(k)
        if v:
            created = v
            break
    lines += [bold("Identity"),
              f"  symbol / name   : {md.get('token_symbol') or info.get('symbol') or '?'}"
              f"  /  {info.get('name') or '?'}",
              f"  launchpad       : {lp.get('launchpad') or yellow('unknown')}"
              f"   platform: {lp.get('platform') or yellow('unknown')}",
              f"  launchpad_status: {lp.get('launchpad_status')}"
              f"   {dim('(0=closed 1=live on the curve 2=migrated)')}",
              f"  curve progress  : "
              f"{(str(round(float(lp.get('progress_pct') or 0), 1)) + '%') if lp.get('progress_pct') is not None else yellow('unknown')}",
              f"  created         : "
              + (datetime.fromtimestamp(float(created), timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ")
                 if created else yellow("unknown")),
              f"  creator / dev   : {str((info.get('dev') or {}).get('creator_address') or info.get('creator') or '?')[:20]}",
              ""]

    # ── the numbers the gates compare against thresholds ────────────────────
    mcap = sig.get("market_cap_usd")
    lines += [bold("Numbers the gates read"),
              f"  market cap      : {_money(mcap)}",
              f"  liquidity       : {_money(sig.get('liquidity_usd'))}",
              f"  volume 24h      : {_money(sig.get('volume_24h_usd'))}",
              f"  buys / sells 24h: {sig.get('buys_24h')} / {sig.get('sells_24h')}",
              f"  price           : {md.get('price_usd')}",
              ""]

    # ── deep, gate-specific evidence ────────────────────────────────────────
    snipers, fees, dist = None, None, None
    if deep:
        try:
            snipers = G.early_sniper_report(mint, cfg)
        except Exception as e:                                # noqa: BLE001
            snipers = {"ok": False, "reason": f"{type(e).__name__}: {e}"[:160]}
        try:
            fees = G.fees_paid(mint, cfg=cfg)
        except Exception as e:                                # noqa: BLE001
            fees = {"ok": False, "reason": f"{type(e).__name__}: {e}"[:160]}
    try:
        dist = G.holder_distribution(mint)
    except Exception as e:                                    # noqa: BLE001
        dist = {"ok": False, "error": f"{type(e).__name__}: {e}"[:160]}

    if snipers:
        th = snipers.get("thresholds") or {}
        lines += [bold(f"Early snipers — the first {snipers.get('first_n')} wallets after the dev's create tx")]
        if not snipers.get("ok"):
            lines.append(yellow(f"  not measured: {snipers.get('reason') or 'no data'}"))
        else:
            lines.append(f"  trader rows     : {snipers.get('rows_seen')} seen, "
                         f"{snipers.get('rows_with_ts')} with a first-buy timestamp")
            for i, w in enumerate((snipers.get("window") or [])[:10], 1):
                tag = red("SNIPER") if w.get("is_sniper") else dim("wallet")
                lines.append(
                    f"   {i:>2d}. {str(w.get('seconds_after_open')) + 's after open' if w.get('seconds_after_open') is not None else 'time unknown':<22s}"
                    f" {_money(w.get('buy_usd')):>10s}  {tag}  {dim(str(w.get('address'))[:10])}")
            lines.append(f"  snipers in window: {snipers.get('sniper_count')} · combined "
                         f"{_money(snipers.get('sniper_total_usd'))} · largest single "
                         f"{_money(snipers.get('max_single_usd'))}")
            lines.append(dim(f"  thresholds: >= {th.get('min_sniper_count')} snipers AND "
                             f"{_money(th.get('max_total_sniper_buy_usd'))} combined, OR any single "
                             f">= {_money(th.get('max_single_sniper_buy_usd'))}"))
        lines.append("")

    if fees is not None:
        lines += [bold("Global fees paid (the migrated-coin gate)")]
        if fees.get("ok"):
            lines.append(f"  value           : {fees.get('value')} "
                         f"{str(fees.get('unit') or '').upper()}   "
                         f"{dim('(source: ' + str(fees.get('source')) + ')')}")
        else:
            lines.append(yellow(f"  not measured: {fees.get('reason') or 'no data'}"))
        lines.append(dim(f"  threshold       : >= {mig.get('min_total_fees')} "
                         f"{str(mig.get('fees_unit') or 'sol').upper()} after migration"))
        lines.append("")

    if dist:
        top1 = dist.get("top1_pct")
        conc = round(float(top1) * 100.0, 2) if top1 is not None else None
        verdict = None if conc is None or not mhp else (conc <= float(mhp))
        lines += [bold("Holder concentration"),
                  f"  top wallet      : "
                  + (f"{conc:.1f}% of supply   {_mark(verdict)}"
                     f"{dim('  (cap ' + str(mhp) + '%)')}" if conc is not None else yellow("unknown")),
                  f"  wallets counted : {dist.get('holder_count')} "
                  f"(of {dist.get('rows_total')} rows returned)"]
        exc = dist.get("excluded_pools") or []
        if exc:
            lines.append("  excluded as pool/burn:")
            for e in exc[:6]:
                lines.append(f"    · {dim(str(e.get('address'))[:12])} "
                             f"{round(float(e.get('pct') or 0) * 100, 1)}% "
                             f"{dim(str(e.get('tags') or ''))}")
        if dist.get("float_share") is not None:
            lines.append(dim(f"  tradeable float : {round(float(dist['float_share']) * 100, 1)}% "
                             f"of supply (burn {round(float(dist.get('burn_pct') or 0) * 100, 1)}% + "
                             f"DEX {round(float(dist.get('dex_pct') or 0) * 100, 1)}% excluded)"))
        lines.append("")

    # ── the real verdict, from the same code the trading loop runs ──────────
    lines += [bold("Pipeline verdict (analyze.run_pipeline — the real trading path)")]
    try:
        dec = A.run_pipeline(mint) or {}
    except Exception as e:                                    # noqa: BLE001
        dec = {"decision": "ANALYSIS_ERROR", "decision_reason": f"{type(e).__name__}: {e}"}
    uni = dec.get("universe") or {}
    decision = str(dec.get("decision") or "?")
    colour = green if decision == "BUY" else (yellow if decision == "WAIT" else red)
    lines.append(f"  decision        : {colour(decision)}"
                 f"   confidence {dec.get('confidence_score')}")
    lines.append(f"  universe        : pump_v1={uni.get('pump_v1')} · "
                 f"platform={uni.get('platform')} · phase={uni.get('phase')}")
    for ev in (uni.get("phase_evidence") or [])[:4]:
        lines.append(dim(f"      evidence: {ev}"))
    for r in (dec.get("rejected_signals") or []):
        lines.append(f"  {red('✘')} {r}")
    for sp in (dec.get("supporting_signals") or [])[:12]:
        lines.append(f"  {green('✔')} {sp}")
    if dec.get("decision_reason"):
        lines.append(dim(f"  reason: {dec['decision_reason']}"))

    payload = {"mint": mint, "provider": {"bin": str(gbin or ""), "dialect": dia,
                                          "status": pst},
               "identity": {"symbol": md.get("token_symbol"), "launchpad": lp,
                            "created": created},
               "numbers": {"market_cap_usd": mcap,
                           "liquidity_usd": sig.get("liquidity_usd"),
                           "volume_24h_usd": sig.get("volume_24h_usd"),
                           "buys_24h": sig.get("buys_24h"),
                           "sells_24h": sig.get("sells_24h"),
                           "price_usd": md.get("price_usd")},
               "snipers": snipers, "fees": fees,
               "holders": {"top1_pct": (dist or {}).get("top1_pct"),
                           "top1_pct_all": (dist or {}).get("top1_pct_all"),
                           "holder_count": (dist or {}).get("holder_count"),
                           "excluded_pools": (dist or {}).get("excluded_pools"),
                           "float_share": (dist or {}).get("float_share"),
                           "cap_pct": mhp},
               "thresholds": {"token_universe": tu, "phase_gates": pg,
                              "sniper_flood": sf, "max_holder_percentage": mhp},
               "decision": dec}
    bad = bool(dec.get("rejected_signals")) or decision in ("DATA_ERROR", "ANALYSIS_ERROR")
    return _set(args, payload, lines, 1 if bad else 0)


def build_parser():
    p = argparse.ArgumentParser(
        prog="enzoctl",
        description="ENZO control plane — start, stop, inspect and diagnose the bot.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Add --json to any command for machine-readable output.\n"
               "Run ./enzoctl doctor first if anything looks wrong.",
    )
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="cmd")

    # `--json` is documented as "add it to any command", but it used to be
    # accepted only BEFORE the subcommand: `enzoctl probe MINT --json` died with
    # "unrecognized arguments". Every subcommand therefore gets the flag too,
    # with default=SUPPRESS so it only overrides when actually typed (otherwise
    # the subparser's False would erase `enzoctl --json probe MINT`).
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")

    def add(name, fn, help_text, **kw):
        parents = [common] + list(kw.pop("parents", []) or [])
        sp = sub.add_parser(name, help=help_text, parents=parents, **kw)
        sp.set_defaults(func=fn)
        return sp

    sp = add("start", cmd_start, "start engine + dashboard + telegram (detached)")
    sp.add_argument("--interval", type=float, help="scan interval seconds")
    sp.add_argument("--no-dashboard", action="store_true")
    sp.add_argument("--no-telegram", action="store_true")
    sp.add_argument("--wait", type=float, default=20, help="seconds to wait for startup")

    sp = add("stop", cmd_stop, "stop the bot")
    sp.add_argument("--grace", type=float, default=15)

    sp = add("restart", cmd_restart, "stop then start")
    sp.add_argument("--interval", type=float)
    sp.add_argument("--grace", type=float, default=15)
    sp.add_argument("--no-dashboard", action="store_true")
    sp.add_argument("--no-telegram", action="store_true")
    sp.add_argument("--wait", type=float, default=20)

    add("status", cmd_status, "is it running? paused? what mode? what capital?")
    add("doctor", cmd_doctor, "full preflight with actionable fixes")
    add("health", cmd_health, "the health snapshot")

    sp = add("logs", cmd_logs, "tail a log file")
    sp.add_argument("which", nargs="?", default="enzo",
                    choices=["enzo", "supervisor", "audit", "error"])
    sp.add_argument("-n", type=int, default=80)
    sp.add_argument("-f", "--follow", action="store_true")

    sp = add("scan", cmd_scan, "run one scan cycle now")
    sp.add_argument("mint", nargs="?")
    sp.add_argument("--force", action="store_true",
                    help="scan even while the engine is running")

    add("pause", cmd_pause, "pause trading (exits still monitored)")
    add("resume", cmd_resume, "resume trading")

    sp = add("unban", cmd_unban,
             "clear an active GMGN ban so data calls resume now")
    sp.add_argument("--confirm", action="store_true",
                    help="actually clear it (without this flag nothing changes)")

    sp = add("rebase", cmd_rebase,
             "accept a realised loss: reset capital base + clear the halt")
    sp.add_argument("--value", type=float,
                    help="explicit new base in USD (default: current equity)")
    sp.add_argument("--confirm", action="store_true",
                    help="apply (without it nothing is changed)")

    sp = add("mode", cmd_mode, "switch paper_mode")
    sp.add_argument("target", choices=["live", "paper"])

    sp = add("positions", cmd_positions, "open positions and recent closed trades")
    sp.add_argument("--limit", type=int, default=10)
    sp = add("trades", cmd_trades, "alias for positions")
    sp.add_argument("--limit", type=int, default=10)

    add("wallet", cmd_wallet, "real balances + deployable capital")

    sp = add("probe", cmd_probe,
             "show what the gates see for one mint, live (identity, phase, snipers, fees, holders, verdict)")
    sp.add_argument("mint", help="token mint address")
    sp.add_argument("--no-deep", action="store_true",
                    help="skip the two extra calls (early snipers, fees paid)")

    sp = add("config", cmd_config, "show the effective config")
    sp.add_argument("section", nargs="?")

    add("dashboard", cmd_dashboard, "regenerate the dashboard HTML")

    sp = sub.add_parser("_supervise", help=argparse.SUPPRESS)
    sp.set_defaults(func=cmd__supervise)
    sp.add_argument("--interval", type=float)
    sp.add_argument("--no-dashboard", action="store_true")
    sp.add_argument("--no-telegram", action="store_true")

    return p


def _logs_to_stderr():
    """Send the shared logger's console output to stderr.

    The logger attaches a stdout StreamHandler, which polluted the control
    plane's answers: `enzoctl --json status | jq` received log lines before the
    JSON, and `enzoctl probe MINT` mixed provider logs into the report. stdout
    is the answer, stderr is the chatter — the engine's own logging is untouched
    because this only runs inside the enzoctl process.

    It goes through log.set_console_stream() rather than moving the handlers that
    happen to exist right now: ENZO's loggers are built lazily on first import of
    each module, so a one-shot sweep missed every logger created afterwards (which
    is most of them — `enzo.executor` only appears once a command imports it).
    """
    try:
        from enzo.core import log as _log
        return _log.set_console_stream(sys.stderr)
    except Exception:                                                # noqa: BLE001
        return 0


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    _logs_to_stderr()
    if not getattr(args, "cmd", None):
        parser.print_help()
        return 0
    try:
        return _out(args.func(args))
    except KeyboardInterrupt:
        print()
        return 130
    except Exception as e:
        import traceback
        if getattr(args, "json", False):
            print(json.dumps({"error": f"{type(e).__name__}: {e}",
                              "traceback": traceback.format_exc()}, indent=2))
        else:
            print(red(f"✖  {type(e).__name__}: {e}"))
            tb = traceback.format_exc().strip().splitlines()
            for line in tb[-4:]:
                print(dim("   " + line))
            if "PyYAML" in str(e) or "Dependency" in type(e).__name__:
                print()
                print(yellow("   Fix: bash bootstrap.sh"))
        return 1


if __name__ == "__main__":
    sys.exit(main())
