def cmd_logs(args):
    C = _paths()
    which = args.which or "enzo"
    mapping = {"enzo": os.path.join(C.LOGS_DIR, "enzo.log"),
               "supervisor": C.SUPERVISOR_LOG_PATH,
               "audit": C.AUDIT_JSONL_PATH,
               "error": os.path.join(C.LOGS_DIR, "enzo-error.log")}
    path = mapping.get(which)
    if not path:
        return _set(args, {"error": f"unknown log '{which}'"},
                    [red(f"unknown log '{which}' — choose from {sorted(mapping)}")], 2)
    if not os.path.exists(path):
        return _set(args, {"error": "not_found", "path": path},
                    [yellow(f"no log at {path}")], 1)

    n = int(args.n or 80)
    if args.follow:
        # execvp replaces this process, so it must not be evaluated inside _set.
        if getattr(args, "json", False):
            print(json.dumps({"path": path, "follow": True}))
            return 0
        print(dim(f"following {path} (Ctrl-C to stop)"))
        os.execvp("tail", ["tail", "-n", str(n), "-f", path])
        return 0

    try:
        from enzo.core.audit import _tail_lines
        lines = _tail_lines(path, n)
    except Exception:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()[-n:]

    if which == "audit" and not args.json:
        pretty = []
        for raw in lines:
            try:
                d = json.loads(raw)
                lvl = str(d.get("level", ""))
                colour = {"ERROR": red, "WARNING": yellow}.get(lvl, lambda x: x)
                ts = dim(str(d.get("ts", ""))[:19])
                lv = colour(f"{lvl:<7s}")
                cat = blue(f"{str(d.get('category', ''))[:11]:<11s}")
                pretty.append(f"{ts} {lv} {cat} {str(d.get('message', ''))[:120]}")
            except Exception:
                pretty.append(raw.rstrip())
        lines = pretty
    else:
        lines = [l.rstrip("\n") for l in lines]

    return _set(args, {"path": path, "lines": lines}, lines, 0)


