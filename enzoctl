def cmd_unban(args):
    """Clear a GMGN ban so data calls resume at once.

    During a ban EVERY gate reads "unknown", so coins are rejected with
    SNIPER_DATA_UNAVAILABLE / FEES_UNKNOWN / MCAP_UNKNOWN - not because of
    anything about them. The ban normally expires on its own; this exists for the
    case where it was registered with a wrong (too long) wait, or the operator
    has just fixed the cause (new API key, lower request rate) and does not want
    to sit out the remaining window.
    """
    from enzo.core import db
    from enzo.providers import gmgn as _gmgn
    left = float(db.rl_get_ban_remaining("gmgn") or 0.0)
    if left <= 0.0:
        return _set(args, {"ok": True, "ban_remaining_sec": 0.0, "changed": False},
                    [green("●  No GMGN ban is registered - data calls are not blocked.")], 0)
    if not getattr(args, "confirm", False):
        return _set(args, {"ok": False, "confirm_required": True,
                           "ban_remaining_sec": round(left, 1)}, [
            yellow(f"⚠  GMGN ban active: {int(left)}s remaining."),
            dim("   Every GMGN call is refused until then, so gates read 'unknown'"),
            dim("   and coins are rejected for lack of data (not on their merits)."),
            dim("   It expires by itself. Clearing it early means the next call may"),
            dim("   be rejected again and GMGN may re-ban for longer."),
            "",
            dim("   If bans keep coming back, slow the pacing down instead:"),
            dim("     data_sources.gmgn.requests_per_sec  (now "
                f"{(_gmgn._rate_per_sec())}) / request_gap_ms"),
            "",
            yellow("   Re-run with --confirm to clear:  ./enzoctl unban --confirm"),
        ], 1)
    cleared = db.rl_clear_ban("gmgn")
    left2 = float(db.rl_get_ban_remaining("gmgn") or 0.0)
    if not cleared or left2 > 0.0:
        return _set(args, {"ok": False, "ban_remaining_sec": round(left2, 1)},
                    [red(f"✖  Ban could not be cleared ({left2:.0f}s still registered).")], 1)
    return _set(args, {"ok": True, "changed": True, "cleared_sec": round(left, 1)},
                [green(f"●  GMGN ban cleared (was {int(left)}s). Data calls resume;"),
                 dim("   the next sweep will show whether GMGN accepts them again.")], 0)


def cmd_rebase(args):
    """Accept a realised loss as the new starting point and re-arm the breakers.

    The drawdown circuit breaker (peak vs equity >= max_drawdown) does NOT clear
    by itself - unlike the daily-loss halt, which resets at UTC midnight. After
    a real loss the bot would otherwise stay halted forever with no sanctioned
    way back, which reads as "the bot is dead". Rebasing resets initial_capital
    AND peak_equity onto today's equity, zeroes daily_loss and clears `halted`,
    so ROI/win-rate are measured from the new base. Closed-trade history is
    kept, but its percentage meaning changes - hence the mandatory --confirm.
    """
    from enzo.core import db
    from enzo.core.config import load_config
    from enzo.execution import portfolio as pf
    cfg = load_config()
    st = pf.load_state()
    eq = float(pf.equity(st) or 0.0)
    halt = pf.is_halted(st, cfg)
    old_base = float(st.get("initial_capital") or 0.0)
    old_peak = float(st.get("peak_equity") or 0.0)
    value = float(args.value) if getattr(args, "value", None) else eq
    if value <= 0:
        return _set(args, {"ok": False}, [yellow("Equity is 0 - nothing to rebase onto.")], 1)
    if not getattr(args, "confirm", False):
        lines = [
            yellow("⚠  rebase accepts the loss and re-arms the risk breakers:"),
            dim(f"   initial_capital : ${old_base:,.2f} -> ${value:,.2f}"),
            dim(f"   peak_equity     : ${old_peak:,.2f} -> ${value:,.2f}"),
            dim("   daily_loss      : reset to 0   ·   halted: cleared"),
            dim("   closed trades are KEPT, but ROI/win-rate are measured"),
            dim("   from the new base from now on."),
            dim(f"   current halt    : {halt or 'none'}"),
            "",
            yellow("   Re-run with --confirm to apply:  ./enzoctl rebase --confirm"),
        ]
        return _set(args, {"ok": False, "confirm_required": True,
                           "current_equity": round(eq, 2), "halt": halt}, lines, 1)
    if not db.atomic_update_initial_capital(value):
        return _set(args, {"ok": False, "changed": False},
                    [yellow(f"Base already equals ${value:,.2f} - nothing changed."),
                     dim("   If a halt persists, equity itself must recover first.")], 1)
    return _set(args, {"ok": True, "new_base": round(value, 2)},
                [green(f"✔ Capital base rebased to ${value:,.2f}; halt cleared."),
                 dim("   The breakers now measure drawdown from this point.")], 0)


