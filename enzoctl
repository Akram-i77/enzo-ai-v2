                     f"{green(f'${pnl:+,.2f}') if pnl >= 0 else red(f'${pnl:+,.2f}')}")
    if not closed:
        lines.append(dim("  none"))
    return _set(args, {"open": opens, "closed": closed[: int(args.limit or 10)]}, lines, 0)


def _age_of(iso):
    if not iso:
        return None
    try:
        dt = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return (datetime.now(timezone.utc) - dt).total_seconds()
    except Exception:
        return None


