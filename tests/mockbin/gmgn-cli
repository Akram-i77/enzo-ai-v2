def filter_rows(rows):
    """Apply --tag / --order-by / --direction / --limit like the real CLI."""
    tag = opts.get("--tag")
    if tag:
        out = []
        for r in rows:
            tags = [str(x).lower() for x in (r.get("maker_token_tags") or [])]
            tags += [str(x).lower() for x in (r.get("tags") or [])]
            if tag.lower() in tags:
                out.append(r)
        rows = out
    order = opts.get("--order-by")
    if order and rows and order in rows[0]:
        rev = str(opts.get("--direction", "desc")).lower() != "asc"
        rows = sorted(rows, key=lambda r: float(r.get(order) or 0.0), reverse=rev)
    lim = opts.get("--limit")
    if lim:
        try:
            rows = rows[:max(0, min(int(lim), 100))]
        except Exception:
            pass
    return rows


