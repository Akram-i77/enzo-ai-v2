#!/usr/bin/env python3
"""Mock of gmgn-cli v1.6.1 with the real tool's exact argument semantics.

Why this exists
---------------
Every market-data decision ENZO makes comes out of this CLI, and until now the
suite had no way to exercise those paths: there was a mock for the MoonPay CLI
(execution) but none for GMGN (data), so the provider was only ever tested
against hand-written dicts. That is how three live breakages stayed invisible -
`token holders --token` / `market kline --token` are rejected by v1.6.1 (it
requires `--address`), `market smartmoney` is not a command at all, and every
call dies without GMGN_API_KEY.

Reproduced faithfully from the published package (dist/ + skills/ docs):
  * GMGN_API_KEY is REQUIRED - the real tool dies before any request;
  * `token info|security|pool|holders|traders` take --chain/--address (--token is
    an "unknown option" / "required option not specified" error, exit 1);
  * `market kline` takes --address and --resolution 30s/1m/5m/15m/1h/4h/1d and
    returns the documented v1.6.1 shape {data: {list: [{time(ms), open:"str", ...}]}}
    ({"kline_arrays": true} in the state gives the old bare-array rows);
  * `market trenches` returns {new_creation, near_completion, completed};
  * `market trending` REQUIRES --chain AND --interval (1m/5m/1h/6h/24h) - both are
    `requiredOption` in the real v1.6.1, and commander aborts before any HTTP call
    when one is missing - and returns {data: {rank: [...]}};
  * `token holders|traders` accept --limit/--order-by/--direction/--tag;
  * output is JSON on stdout (compact with --raw, pretty without), notices on
    stderr, and errors are `[gmgn-cli] Error: ...` with exit 1.

Scenario control: GMGN_MOCK_STATE is a JSON object whose keys override the
defaults - `token_info`, `traders`, `holders`, `trenches`, `trending`,
`created_tokens`, `kline`, `security`, `pool`, `fail` ({endpoint,rc,err}),
`no_api_key` (bool), `legacy_dialect` (accept --token like pre-1.6 builds).
"""
import json
import os
import sys
import time

NOW = int(time.time())
MINT_DEFAULT = "MockPumpToken11111111111111111111111111111"
DEV_DEFAULT = "MockDevWallet1111111111111111111111111111111"


def _state():
    raw = os.environ.get("GMGN_MOCK_STATE") or ""
    if not raw.strip():
        return {}
    try:
        s = json.loads(raw)
        return s if isinstance(s, dict) else {}
    except Exception:
        return {}


def die(msg, rc=1):
    sys.stderr.write(f"[gmgn-cli] Error: {msg}\n")
    sys.exit(rc)


def commander_error(msg):
    """commander's own option errors are printed without the [gmgn-cli] prefix."""
    sys.stderr.write(f"error: {msg}\n")
    sys.exit(1)


def emit(data, raw=False):
    sys.stdout.write(json.dumps(data) if raw else json.dumps(data, indent=2))
    sys.stdout.write("\n")
    sys.exit(0)


# ── argument parsing (commander semantics: unknown option = hard error) ──────
argv = sys.argv[1:]
if not argv or argv[0] in ("-h", "--help", "help"):
    emit_help = True
else:
    emit_help = False

if "-V" in argv or "--version" in argv:
    print("1.6.1")
    sys.exit(0)

pos = [a for a in argv if not a.startswith("--")]
opts = {}
i = 0
while i < len(argv):
    a = argv[i]
    if a.startswith("--"):
        if a == "--raw":
            opts["raw"] = True
        elif i + 1 < len(argv) and not argv[i + 1].startswith("--"):
            opts[a] = argv[i + 1]
            i += 1
        else:
            opts[a] = True
    i += 1

GROUP = pos[0] if pos else ""
CMD = pos[1] if len(pos) > 1 else ""
ST = _state()

# Record every invocation so tests can assert on the exact argv the provider
# built (--address vs --token, --launchpad-platform vs --platform, --raw, ...).
_log = os.environ.get("GMGN_ARGV_LOG")
if _log:
    try:
        with open(_log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"argv": argv}) + "\n")
    except Exception:
        pass

if emit_help:
    print("Usage: gmgn-cli [options] [command]")
    print("Commands: token, market, portfolio, track, swap, order, gas-price, cooking, config")
    sys.exit(0)

# ── the API key gate: the real tool refuses everything without it ────────────
if ST.get("no_api_key") or not os.environ.get("GMGN_API_KEY"):
    die("GMGN_API_KEY is required. Set it in your .env file or environment.")

# ── failure injection ────────────────────────────────────────────────────────
_fail = ST.get("fail") or {}


def maybe_fail(endpoint):
    if _fail.get("endpoint") == endpoint:
        sys.stderr.write(str(_fail.get("err") or "injected failure") + "\n")
        sys.exit(int(_fail.get("rc") or 1))


# ── address dialect: v1.6 requires --address; --token is an error ────────────
def address_or_die(legacy_ok=False):
    """--address (gmgn-cli >= 1.6); --token on older builds.

    ``legacy_only`` in the mock state emulates an OLD build: --address must be
    REJECTED so the provider's dialect fallback to --token is exercised.
    """
    if bool(ST.get("legacy_only")) and "--address" in opts:
        commander_error("unknown option '--address'")
    if "--address" in opts:
        return opts["--address"]
    if legacy_ok and "--token" in opts:
        return opts["--token"]
    if "--token" in opts:
        commander_error("unknown option '--token'")
    commander_error("required option '--address <address>' not specified")


LEGACY = bool(ST.get("legacy_dialect"))

